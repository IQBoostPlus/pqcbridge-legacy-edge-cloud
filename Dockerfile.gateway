# Edge gateway (project prompt section 11).
# NOT production-ready - this is a university test-environment image.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY common/ ./common/
COPY gateway/ ./gateway/

EXPOSE 5001 8001

CMD ["python", "-m", "gateway.gateway"]
